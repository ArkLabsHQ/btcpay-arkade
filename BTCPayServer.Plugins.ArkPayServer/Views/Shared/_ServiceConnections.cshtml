@model BTCPayServer.Plugins.ArkPayServer.Models.StoreOverviewViewModel

@{
    var compactMode = ViewData["CompactMode"] as bool? ?? false;

    // Build Arkade tooltip content
    var arkTooltip = Model.ArkOperatorConnected
        ? $"Arkade Operator: Connected\n{Model.ArkOperatorUrl}"
        : $"Arkade Operator: {Model.ArkOperatorError ?? "Disconnected"}\n{Model.ArkOperatorUrl}";

    // Reports how a solver is reached, not whether one answered: both sides of the RFQ transport
    // dial out and neither listens, so the first evidence a solver is there is a quote coming back.
    // A blank relay and pubkey mean discovery — one is chosen per trade, so there is no one address
    // to name here.
    var solverNamed = !string.IsNullOrEmpty(Model.SolverRelayUrl);
    var solverTooltipLines = new List<string>();
    if (Model.SolverConfigured)
    {
        solverTooltipLines.Add(solverNamed
            ? "Arkade swap solver: Named in ark.json"
            : "Arkade swap solver: Chosen per payment from the public registry");
        if (solverNamed)
        {
            solverTooltipLines.Add(Model.SolverRelayUrl!);
            if (!string.IsNullOrEmpty(Model.SolverPubkey))
            {
                solverTooltipLines.Add($"Solver: {Model.SolverPubkey}");
            }
        }
        solverTooltipLines.Add("Send and receive available");
    }
    else
    {
        solverTooltipLines.Add("Arkade swap solver: Unavailable");
        solverTooltipLines.Add("This network has no solver registry — name one with 'solver-relay' and 'solver-pubkey' in ark.json");
    }
    var solverTooltip = string.Join("\n", solverTooltipLines);
}

@if (compactMode)
{
    <!-- Compact Mode: Status circles with hover tooltips -->
    <div class="d-flex align-items-center gap-3">
        <!-- Ark Status -->
        <div class="d-flex align-items-center gap-2" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-html="true" title="@arkTooltip.Replace("\n", "<br/>")">
            @if (Model.ArkOperatorConnected)
            {
                <span class="status-circle status-connected">
                    <vc:icon symbol="checkmark" />
                </span>
            }
            else
            {
                <span class="status-circle status-disconnected">
                    <vc:icon symbol="cross" />
                </span>
            }
            <span class="small text-muted">Arkade</span>
        </div>

        <!-- Arkade solver status -->
        <div class="d-flex align-items-center gap-2" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-html="true" title="@solverTooltip.Replace("\n", "<br/>")">
            @if (Model.SolverConfigured)
            {
                <span class="status-circle status-connected">
                    <vc:icon symbol="checkmark" />
                </span>
            }
            else
            {
                <span class="status-circle status-disconnected">
                    <vc:icon symbol="cross" />
                </span>
            }
            <span class="small text-muted">Lightning</span>
        </div>
    </div>

    <style>
        .status-circle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 20px;
            height: 20px;
            border-radius: 50%;
        }
        .status-circle svg {
            width: 12px;
            height: 12px;
        }
        .status-connected {
            background-color: var(--btcpay-success);
            color: white;
        }
        .status-disconnected {
            background-color: var(--btcpay-danger);
            color: white;
        }
    </style>
}
else
{
    <!-- Full Mode: Service status rows -->
    <div class="d-flex flex-column gap-3">
        <!-- Arkade Operator -->
        <div class="d-flex align-items-start gap-3">
            @if (Model.ArkOperatorConnected)
            {
                <span class="status-circle-lg status-connected flex-shrink-0">
                    <vc:icon symbol="checkmark" />
                </span>
            }
            else
            {
                <span class="status-circle-lg status-disconnected flex-shrink-0">
                    <vc:icon symbol="cross" />
                </span>
            }
            <div class="flex-fill min-w-0">
                <h6 class="mb-1">Arkade Operator</h6>
                @if (!string.IsNullOrEmpty(Model.ArkOperatorUrl))
                {
                    <div class="text-muted small font-monospace text-break">@Model.ArkOperatorUrl</div>
                }
                @if (!Model.ArkOperatorConnected && !string.IsNullOrEmpty(Model.ArkOperatorError))
                {
                    <div class="text-danger small mt-1">@Model.ArkOperatorError</div>
                }
                else if (Model.ArkOperatorConnected)
                {
                    <div class="text-success small mt-1">Connected</div>
                }
            </div>
        </div>

        <!-- Arkade swap solver -->
        <div class="d-flex align-items-start gap-3">
            @if (Model.SolverConfigured)
            {
                <span class="status-circle-lg status-connected flex-shrink-0">
                    <vc:icon symbol="checkmark" />
                </span>
            }
            else
            {
                <span class="status-circle-lg status-disconnected flex-shrink-0">
                    <vc:icon symbol="cross" />
                </span>
            }
            <div class="flex-fill min-w-0">
                <h6 class="mb-1">Lightning (Arkade solver)</h6>
                @if (Model.SolverConfigured && solverNamed)
                {
                    <div class="text-muted small font-monospace text-break">@Model.SolverRelayUrl</div>
                    @if (!string.IsNullOrEmpty(Model.SolverPubkey))
                    {
                        <div class="text-muted small font-monospace text-break">@Model.SolverPubkey</div>
                    }
                    <div class="text-success small mt-1">Named in ark.json</div>
                }
                else if (Model.SolverConfigured)
                {
                    <div class="text-muted small">Chosen per payment from the public solver registry.</div>
                    <div class="text-success small mt-1">Available</div>
                }
                else
                {
                    <div class="text-danger small mt-1">
                        Unavailable — this network has no solver registry. Name one with &lsquo;solver-relay&rsquo; and &lsquo;solver-pubkey&rsquo; in ark.json.
                    </div>
                }
            </div>
        </div>
    </div>

    <style>
        .status-circle-lg {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
        }
        .status-circle-lg svg {
            width: 16px;
            height: 16px;
        }
        .status-connected {
            background-color: var(--btcpay-success);
            color: white;
        }
        .status-disconnected {
            background-color: var(--btcpay-danger);
            color: white;
        }
    </style>
}
