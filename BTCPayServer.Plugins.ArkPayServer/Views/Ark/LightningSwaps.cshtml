@using BTCPayServer.Abstractions.Contracts
@using BTCPayServer.Abstractions.Extensions
@using NArk.ArkadeIntents.Models
@model BTCPayServer.Plugins.ArkPayServer.Models.StoreLightningSwapsViewModel
@inject IScopeProvider ScopeProvider
@{
    ViewData.SetActivePage(category: "Ark", activePage: "LightningSwaps", title: "Arkade - Lightning swaps");
    var storeId = ScopeProvider.GetCurrentStoreId();

    // Status carries the only thing a merchant needs at a glance: whether this swap still wants
    // something from them. Claimable and Refundable do; the rest are either waiting on someone else
    // or over.
    string Badge(ArkadeSwapIntentStatus s) => s switch
    {
        ArkadeSwapIntentStatus.Fulfilled => "text-bg-success",
        ArkadeSwapIntentStatus.Claimable or ArkadeSwapIntentStatus.Refundable => "text-bg-warning",
        ArkadeSwapIntentStatus.Cancelled or ArkadeSwapIntentStatus.Resolved => "text-bg-secondary",
        ArkadeSwapIntentStatus.Recoverable => "text-bg-danger",
        _ => "text-bg-info"
    };

    string Direction(ArkadeSwapIntentType t) =>
        t == ArkadeSwapIntentType.LightningToBtc ? "Received" : "Sent";
}

<div class="sticky-header d-flex align-items-center justify-content-between">
    <h2 class="mb-0" text-translate="true">Lightning swaps</h2>
</div>

<partial name="_StatusMessage" />
<partial name="_ArkadeOperatorStatusBanner" />

@if (!Model.SolverConfigured)
{
    <div class="alert alert-warning mb-4" role="alert">
        <span text-translate="true">
            No Arkade swap solver is configured, so no new Lightning payment can be settled. Set
            <code>solver-relay</code> and <code>solver-pubkey</code> in the Arkade network configuration.
        </span>
    </div>
}

@if (!Model.Swaps.Any())
{
    <p class="text-secondary my-4" text-translate="true">
        No Lightning swaps yet. One is recorded each time this store is paid over Lightning, or pays
        a Lightning invoice from its Arkade balance.
    </p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th text-translate="true">Created</th>
                    <th text-translate="true">Direction</th>
                    <th text-translate="true">Status</th>
                    <th class="text-end" text-translate="true">Amount</th>
                    <th class="text-end" text-translate="true">Fee</th>
                    <th text-translate="true">Payment hash</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var swap in Model.Swaps)
            {
                var received = swap.Type == ArkadeSwapIntentType.LightningToBtc;

                @* The spread, and which side of it the merchant sees. Sending, we lock more than the
                   invoice is for; receiving, we are credited less than the payer was billed. Either
                   way the difference is what the corridor cost. *@
                var billed = received ? swap.OfferAmount : swap.WantAmount;
                var landed = received ? swap.WantAmount : swap.OfferAmount;
                var fee = received ? billed - landed : landed - billed;

                <tr>
                    <td>@swap.CreatedAt.ToBrowserDate()</td>
                    <td>@Direction(swap.Type)</td>
                    <td><span class="badge @Badge(swap.Status)">@swap.Status</span></td>
                    <td class="text-end font-monospace">@billed.Satoshi.ToString("N0") sats</td>
                    <td class="text-end font-monospace text-secondary">@fee.Satoshi.ToString("N0") sats</td>
                    <td>
                        @if (!string.IsNullOrEmpty(swap.PaymentHash))
                        {
                            <vc:truncate-center text="@swap.PaymentHash" classes="truncate-center-id" />
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <vc:pager view-model="Model" />
}
