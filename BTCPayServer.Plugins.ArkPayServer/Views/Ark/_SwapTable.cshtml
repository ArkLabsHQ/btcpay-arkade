@using BTCPayServer.Abstractions.Extensions
@using BTCPayServer.Plugins.ArkPayServer.Helpers
@using BTCPayServer.Plugins.ArkPayServer.Data.Legacy
@using NBitcoin
@inject ArkNetworkConfig ArkNetworkConfig
@model IEnumerable<LegacySwap>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th text-translate="true">Swap ID</th>
                    <th text-translate="true">Type</th>
                    <th text-translate="true">Amount</th>
                    <th text-translate="true">@(ViewData["TimeColumnLabel"] ?? "Created")</th>
                    <th text-translate="true">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var swap in Model)
                {

                    <tr>
                        <td>
                            <vc:truncate-center text="@swap.SwapId" classes="truncate-center-id"/>
                        </td>
                        <td>
                            @if (swap.SwapType == LegacySwapType.ReverseSubmarine)
                            {
                                <span class="badge text-bg-primary">Reverse</span>
                            }
                            else
                            {
                                <span class="badge text-bg-info">Submarine</span>
                            }
                        </td>
                        <td>@Money.Satoshis(swap.ExpectedAmount).ToDecimal(MoneyUnit.BTC) BTC</td>
                        <td>
                            @if (ViewData["UseTimeAgo"] as bool? ?? false)
                            {
                                @swap.CreatedAt.ToTimeAgo()
                            }
                            else
                            {
                                @swap.CreatedAt.ToBrowserDate()
                            }
                        </td>
                        <td>
                            @{
                                var swapclass = swap.Status switch
                                {
                                    LegacySwapStatus.Pending => "text-bg-info",
                                    LegacySwapStatus.Settled => "text-bg-success",
                                    LegacySwapStatus.Failed => "text-bg-danger",
                                    _ => "text-bg-warning"
                                };
                            }

                            <span class="badge @swapclass">@Enum.GetName(typeof(LegacySwapStatus), swap.Status)</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
